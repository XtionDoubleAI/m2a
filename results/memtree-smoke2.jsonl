{"qa_id": "qa_015", "pred_tool": "Compile C++ 14 Code", "gold_tool": "Compile C++ 14 Code", "pred_args": {"code": "int main() {\n    // Your C++ 14 code goes here\n    return 0;\n}"}, "gold_args": {"code": "#include <string>\n#include <regex>\n\nstd::string markdown_to_html(const std::string& md) {\n    std::string html = md;\n    // ---- headers ----\n    html = std::regex_replace(html, std::regex(\"^### (.+)$\", std::regex_constants::multiline), \"<h3>$1</h3>\");\n    html = std::regex_replace(html, std::regex(\"^## (.+)$\",  std::regex_constants::multiline), \"<h2>$1</h2>\");\n    html = std::regex_replace(html, std::regex(\"^# (.+)$\",   std::regex_constants::multiline), \"<h1>$1</h1>\");\n    // ---- inline ----\n    html = std::regex_replace(html, std::regex(R\"(\\*\\*(.+?)\\*\\*)\"), \"<strong>$1</strong>\");\n    html = std::regex_replace(html, std::regex(R\"(\\*(.+?)\\*)\"),   \"<em>$1</em>\");\n    html = std::regex_replace(html, std::regex(R\"(\\`(.+?)\\`)\"),   \"<code>$1</code>\");\n    // ---- paragraphs ----\n    html = std::regex_replace(html, std::regex(\"\\n\\n\"), \"</p>\\n<p>\");\n    if (!html.empty() && html.front() != '<') html = \"<p>\" + html;\n    if (!html.empty() && html.back()  != '>') html += \"</p>\";\n    return html;\n}"}, "tool_correct": true, "tsa": true, "em": false, "f1": 0.03278688524590164, "bleu1": 0.2, "slot_acc": 0.0, "level": "L2", "has_session": true, "latency_s": 0.832}
